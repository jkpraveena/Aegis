APP_ENV=development
APP_NAME=Aegis
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./aegis.db
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=replace-with-a-long-random-password
AEGIS_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_REQUEST_BYTES=20000000
MAX_UPLOAD_BYTES=15000000
MAX_CSV_ROWS=100000
UPLOAD_DIR=./data/uploads
# Ollama OpenAI-compatible chat endpoint. Leave LLM_MODEL empty for deterministic mode.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# Optional Ollama embeddings; retrieval always works with BM25 if embeddings are unavailable.
EMBEDDING_URL=http://localhost:11434/api/embeddings
EMBEDDING_MODEL=
RETRIEVAL_TOP_K=6
